# ==========================================
# 后端环境变量示例 - 复制为 .env 后填写
# ==========================================

# ---------- 应用 ----------
NODE_ENV=development
PORT=3000

# ---------- CORS ----------
# 多个来源用英文逗号分隔
CORS_ORIGIN=http://localhost:5173

# ---------- MongoDB ----------
MONGO_URI=mongodb://127.0.0.1:27017/netdisk_resources

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 生产环境务必替换为高强度随机值： openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 邮件 (SMTP) ----------
# 可选值： smtp（真实发信，默认） | json（仅用于自动化测试，不真实发信）
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=培鑫盈资源网创
MAIL_FROM_ADDRESS=

# ---------- 验证码 ----------
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_TOKEN_TTL_SECONDS=1800

# ---------- 安全 ----------
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
